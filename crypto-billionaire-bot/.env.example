# =============================================================
# CRYPTO BILLIONAIRE BOT - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================

# -------------------------------------------------------------
# SERVER CONFIGURATION
# -------------------------------------------------------------

# Port for the Express server (Railway sets this automatically)
PORT=3000

# Environment: 'development' or 'production'
NODE_ENV=development

# -------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Railway provides this automatically when you add a PostgreSQL plugin
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_bot

# -------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------

# Log level: 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=info

# -------------------------------------------------------------
# TELEGRAM BOT (Part 2)
# -------------------------------------------------------------

# Your Telegram Bot Token from @BotFather
# TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram Chat ID for admin notifications
# TELEGRAM_ADMIN_CHAT_ID=your_chat_id_here

# -------------------------------------------------------------
# EXCHANGE API (Part 2)
# -------------------------------------------------------------

# Binance API credentials (for price data - read-only is fine)
# BINANCE_API_KEY=your_binance_api_key
# BINANCE_API_SECRET=your_binance_api_secret

# -------------------------------------------------------------
# OPTIONAL: EXTERNAL SERVICES (Future Parts)
# -------------------------------------------------------------

# OpenAI API key (for AI-enhanced analysis - Part 3)
# OPENAI_API_KEY=your_openai_api_key

# CoinGecko API key (optional, for additional data)
# COINGECKO_API_KEY=your_coingecko_api_key
