# =============================================================
# CRYPTO BILLIONAIRE BOT - Environment Configuration
# =============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# =============================================================

# -------------------------------------------------------------
# SERVER CONFIGURATION
# -------------------------------------------------------------

# Port for the Express server (Railway sets this automatically)
PORT=3000

# Environment: 'development' or 'production'
NODE_ENV=development

# Timezone for display (storage is always UTC)
TZ=Asia/Kolkata

# -------------------------------------------------------------
# DATABASE CONFIGURATION
# -------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# Railway provides this automatically when you add a PostgreSQL plugin
DATABASE_URL=postgresql://user:password@localhost:5432/crypto_bot

# -------------------------------------------------------------
# TELEGRAM BOT (REQUIRED for Part 4)
# -------------------------------------------------------------

# Your Telegram Bot Token from @BotFather
# Create a bot: https://t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram Chat ID for receiving briefings
# Get your chat ID: https://t.me/userinfobot
TELEGRAM_CHAT_ID=your_chat_id_here

# Admin key for protected API endpoints (optional)
ADMIN_KEY=your_secret_admin_key

# -------------------------------------------------------------
# AI NARRATION (REQUIRED for Gemini features)
# -------------------------------------------------------------

# Google Gemini API key for AI narration
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------------------------------------------
# MARKET DATA APIS (REQUIRED)
# -------------------------------------------------------------

# CoinGecko Demo API Key (REQUIRED for market radar)
# Get your free demo key at: https://www.coingecko.com/en/api/pricing
COINGECKO_API_KEY=your_coingecko_demo_api_key

# Bybit API base URL (public endpoints, no auth needed)
BYBIT_BASE_URL=https://api.bybit.com

# Binance Futures API base URL (public endpoints, no auth needed)
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# -------------------------------------------------------------
# PLANETARY VERIFICATION (Optional)
# -------------------------------------------------------------

# JPL Horizons verification (optional, free, no key needed)
# Set to 'false' to disable Horizons verification
HORIZONS_ENABLED=true

# Prokerala API verification (optional, requires free API key)
# Set to 'false' to disable Prokerala verification
PROKERALA_ENABLED=false

# Prokerala API Key (optional - for human-facing verification)
# Get your free key at: https://api.prokerala.com/
# PROKERALA_API_KEY=your_prokerala_api_key

# -------------------------------------------------------------
# LOGGING
# -------------------------------------------------------------

# Log level: 'error', 'warn', 'info', 'debug', 'trace'
LOG_LEVEL=info

# =============================================================
# RAILWAY DEPLOYMENT - Required Variables
# =============================================================
# When deploying to Railway, set these in the Variables tab:
#
# REQUIRED:
#   TELEGRAM_BOT_TOKEN      - Your bot token from @BotFather
#   TELEGRAM_CHAT_ID        - Your personal chat ID
#   GEMINI_API_KEY          - Google Gemini API key
#   DATABASE_URL            - Auto-provided by Railway PostgreSQL
#   COINGECKO_API_KEY       - CoinGecko demo API key
#
# RECOMMENDED:
#   TZ=Asia/Kolkata         - Timezone for IST display
#   NODE_ENV=production     - Production mode
#   BYBIT_BASE_URL          - Default: https://api.bybit.com
#   BINANCE_FUTURES_BASE_URL - Default: https://fapi.binance.com
#
# OPTIONAL:
#   ADMIN_KEY               - For protected API endpoints
#   HORIZONS_ENABLED        - Default: true
#   PROKERALA_ENABLED       - Default: false
#   PROKERALA_API_KEY       - If Prokerala enabled
# =============================================================
