{
  "name": "crypto-billionaire-bot",
  "version": "1.0.0",
  "description": "Billionaire-level crypto intelligence Telegram bot for personal intraday futures analysis",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test:gann": "node -e \"const gann = require('./modules/gann'); console.log(JSON.stringify(gann.squareOf9(45000), null, 2));\"",
    "test:planetary": "node scripts/test-planetary.js",
    "test:market": "node scripts/test-market-data.js",
    "job:briefing": "node -e \"require('./jobs/daily-briefing').runNow()\"",
    "job:warroom": "node -e \"require('./jobs/weekly-war-room').runNow()\"",
    "job:calibrate": "node -e \"require('./jobs/weekly-calibration').runNow()\""
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.64.0",
    "pg": "^8.11.3",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "keywords": [
    "crypto",
    "trading",
    "gann",
    "telegram",
    "intelligence",
    "astrology",
    "cycles"
  ],
